# Auto detect text files and perform LF normalization
* text=auto

# Python source files
*.py text diff=python
*.pyw text

# Configuration files
*.cfg text
*.conf text
*.ini text
*.toml text
*.yaml text
*.yml text
*.json text

# Documentation
*.md text
*.rst text
*.txt text

# Web
*.html text diff=html
*.css text
*.js text
*.svg text

# Shell / scripts
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Makefile
Makefile text
makefile text

# Media files (binary)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp4 binary
*.mov binary
*.avi binary
*.mkv binary
*.mp3 binary
*.wav binary
*.m4a binary
*.ogg binary

# Archives
*.zip binary
*.tar.gz binary
*.7z binary
*.rar binary

# Database
*.db binary
*.sqlite binary

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Tools
*.exe binary
*.dll binary
*.so binary
*.dylib binary
